# Alfa-Bank Belarus OAuth / API config (read by the backend/transport layer).
# Copy to `.env` and fill in. NEVER commit real secrets — `.env` is gitignored.
#
# OAuth base URL: sandbox `https://developerhub.alfabank.by:8273`,
# production `https://ibapi2.alfabank.by:8273`.
ALFA_BASE_URL=https://developerhub.alfabank.by:8273
# production:
# ALFA_BASE_URL=https://ibapi2.alfabank.by:8273

# client_id / redirect_uri are not secrets (they appear in the browser /authorize
# URL). redirect_uri MUST exactly match the one registered in the Alfa app.
ALFA_CLIENT_ID=your-client-id
ALFA_REDIRECT_URI=https://bank-import.bx-shef.by/oauth-alfabank-by/

# SECRET — server-side only, never in the repo or in chat/logs.
ALFA_CLIENT_SECRET=

# --- Frontend deploy (landing SSG image) ----------------------------------
# Domain the landing/in-portal image is served from (docker-compose.prod.yml:
# VIRTUAL_HOST / LETSENCRYPT_HOST for the nginx-proxy + acme-companion).
DOMAIN=bank-import.bx-shef.by
# ACME contact email for the TLS cert (acme-companion). Per-vhost override of
# the proxy's global DEFAULT_EMAIL.
LETSENCRYPT_EMAIL=shevchik.mail@gmail.com
# Author shown in the landing footer (build args → runtimeConfig.public.author*).
# Optional — defaults are baked into nuxt.config.ts.
NUXT_PUBLIC_AUTHOR_NAME=bx-shef
NUXT_PUBLIC_AUTHOR_URL=https://bx-shef.by
# Public URL the app is served from — used by the Bitrix24 install handler for
# absolute placement URLs (needed once placement.bind lands). Build-time only.
NUXT_PUBLIC_SITE_URL=https://bank-import.bx-shef.by

# --- Backend (B24 webhook endpoint + portal token store) ------------------
# Read by the `backend` service (docker-compose). The B24 event handler URL
# (ONAPPINSTALL/ONAPPUNINSTALL) points at /api/b24/events of this service.
# A startup check (server/plugins/envCheck.ts) validates these at boot and logs
# `[env] …` for anything wrong (bad key length, a CHANGE_ME token, missing DB).
#
# 32-byte key encrypting portal refresh_token at rest (AES-256-GCM).
# Generate: openssl rand -hex 32. Required — no default (a known key = no encryption).
B24_TOKEN_ENC_KEY=
# Previous key, ONLY while rotating (docs/OPERATIONS.md «Ротация ключа шифрования»). Decryption
# tries the current key first, then this one; encryption always uses the current key, so rows
# re-encrypt themselves as tokens refresh. Keep it for at least 180 days (an idle portal is only
# re-saved by keep-alive in the 177-180 day near-expiry band) and verify with the query in
# docs/OPERATIONS.md before removing; bank_tokens do NOT re-encrypt on their own without polling. Without this variable a key change orphans EVERY stored refresh token, and
# the failure is silent (envCheck only checks the length).
# B24_TOKEN_ENC_KEY_OLD=
# DEPLOY-MODE DECISION (#242 P3, full checklist in docs/DEPLOY.md):
#  - SINGLE portal / self-hosted (not the Marketplace): SET THIS. Without it the
#    install runs in TOFU mode (accepts the first non-empty token), so whoever knows
#    the webhook URL could "install" an arbitrary member_id. The env token closes it.
#  - MULTI-TENANT (Marketplace, many portals): LEAVE EMPTY ON PURPOSE — application_token
#    arrives PER PORTAL inside ONAPPINSTALL and is stored write-once (later events verify
#    against it); a single value can't match every portal. Residual TOFU risk is only the
#    install window, blunted by the atomic write-once + webhook-URL secrecy.
# Also the guard token for the server-only diagnostic (/api/queues).
# See docs/B24_EVENTS.md / docs/DEPLOY.md.
B24_APPLICATION_TOKEN=
# App OAuth credentials (client_id / client_secret of the registered B24 app).
# Needed to refresh the portal access token for server-side REST (app.option, etc.).
# Optional for a test right after install (the frame token is fresh ~1h); required
# for long-lived operation once tokens age out.
# client_id is not secret; B24_CLIENT_SECRET IS a real secret — server-side only,
# never in the repo or in chat/logs (same handling as ALFA_CLIENT_SECRET above).
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# SSRF allow-list for the outbound REST host (#149). The frame routes take the portal
# `domain` from a caller-supplied header, so callRest only ever POSTs to a cloud
# `*.bitrix24.<tld>` portal by default. If you run a SELF-HOSTED (on-prem) Bitrix24 on a
# custom domain, list its host(s) here (comma/space separated) — else its REST is refused.
# Cloud portals need nothing here. Example: B24_SELFHOSTED_HOSTS=b24.acme.tld,crm.corp.local
# HOST ONLY: exact hostname match (no wildcard `*.acme.tld`), no port — REST always uses
# https on :443. A scheme/path in an entry is stripped to its bare host.
B24_SELFHOSTED_HOSTS=
# Postgres password for the `db` service. Required by docker-compose.prod.yml
# (used for both the db and the backend's DATABASE_URL). Use a URL-safe value with
# no @ : / ? # — the DSN embeds it unencoded. `openssl rand -hex 24` is ideal.
POSTGRES_PASSWORD=
# Postgres DSN. Prod compose builds it from POSTGRES_PASSWORD automatically; set
# this only when running the backend outside compose.
# DATABASE_URL=postgres://app:app@db:5432/app
# Redis DSN for the BullMQ pipeline (events → fetch → parse → crm-sync). Compose
# sets it to the internal `redis` service; override only when running outside compose.
# REDIS_URL=redis://redis:6379
# Cron poll interval in minutes (default 5) for REAL polling (A10). On the cron instance,
# every CRON_INTERVAL_MIN the poller enqueues one fetch job per connected bank account
# (A6 registry over the bank_tokens store) for a rolling window [today−CRON_LOOKBACK_DAYS,
# today]. INERT until accounts are connected (A7) — an empty registry enqueues nothing.
# DEFAULT OFF (opt-in) — the A8 rate limiter isn't built yet and this drives the live Alfa
# API (100 req/min), so enable it (CRON_REAL_POLL=1) only alongside A8, so connecting the
# first account (A7) can't silently start unthrottled polling. CRON_LOOKBACK_DAYS (default 1)
# re-covers days where operations post late. Only providers in POLLABLE_PROVIDERS are scheduled
# (Alfa and Prior; Prior has its own queue and a request-based budget).
# CRON_REAL_POLL=0
# Prior's fetch queue is SEPARATE from Alfa's (bank-fetch-prior) because one Prior job costs ~10
# bank requests and can run for minutes. QUEUE_PRIOR_RATE_MAX is a budget in REQUESTS per window —
# the limiter needs JOBS, so it is divided by the per-job cost (100 req/min → 10 jobs/min).
# QUEUE_PRIOR_CONCURRENCY is its own slot count (default 4) so a slow create+poll can't head-of-line
# block Alfa. Both clamp on bad input (a typo can never disable the cap). See docs/QUEUES.md.
# QUEUE_PRIOR_RATE_MAX=100
# QUEUE_PRIOR_RATE_DURATION_MS=60000
# QUEUE_PRIOR_CONCURRENCY=4
# CRON_LOOKBACK_DAYS=1
# How often the cron instance renews BANK refresh tokens (minutes, default 60; clamped [5, 240]).
# NOT gated by CRON_REAL_POLL — that flag exists to avoid hammering the STATEMENT api, and renewing
# a token is not a statement read. Measured on production (#488): Alfa's refresh lives ~10h and is
# otherwise renewed only as a side effect of polling, so a connection made in the afternoon is dead
# by morning whenever polling is paused. Keep this well BELOW the near-expiry band (2h for Alfa) —
# a scan rarer than the band can step over it entirely.
# ⚠ The ceiling is DERIVED from that band (half of it), not a fixed number — a value above it is
# clamped down rather than honoured, because a honoured-but-useless schedule is the worse failure.
# BANK_KEEPALIVE_MINUTES=60
# Reveal the PAYMENT PURPOSE in the per-operation `[op]` log line (worker only — crm-sync runs
# there; on backend it does nothing). DEFAULT OFF. Everything else in `[op]` — account, docId,
# direction, currency, counterparty account, recognition count, outcome — is logged regardless;
# only the purpose is gated, because it is payer-authored free text that docs/PRIVACY.md §Логи
# deliberately keeps out. Turn it on to CALIBRATE the recognition matrices (you cannot write a
# mask for a numbering you have never seen), then turn it back off — the same posture as raising
# the crypto gateway's error-log level for a live run.
# STATEMENT_DEBUG_LOG=0
# Load demo: DEMO_LOAD_N>0 makes the demo enqueue that many synthetic
# fetch jobs every DEMO_TICK_SEC seconds (default 5), and DEMO_DELAY_MS (default 600)
# is an artificial per-job processing pause applied ONLY to demo accounts so the
# queues show a visible backlog on the /queues chart (0 = instant drain, flat line).
# Watch via /queues (operator session) or scripts/queue-stats.sh. Set DEMO_LOAD_N=0
# in prod once real polling lands. Keep the demo self-limiting (crm-sync won't grow):
#   DEMO_LOAD_N * 2 * DEMO_DELAY_MS <= DEMO_TICK_SEC * 1000  (defaults 3/600/5 ≈ 72%).
# CRON_INTERVAL_MIN=5
# DEMO_LOAD_N=0
# DEMO_TICK_SEC=5
# DEMO_DELAY_MS=600
# Proactive OAuth keep-alive (#175): once every N hours the cron instance refreshes only
# portals whose refresh_token is within ~3 days of its ~180-day expiry, so idle portals
# don't silently lose auth. Needs B24_CLIENT_ID/SECRET. Default 24h; clamped to [1h, 168h]
# (the near-expiry window is only ~3 days, so a longer cadence would miss portals; B24 also
# warns that frequent refreshing risks an app auto-block, so daily is the sweet spot).
# TOKEN_KEEPALIVE_HOURS=24

# Wall-clock retention sweep for the statement-PII queues (#245, docs/PRIVACY.md): the cron
# instance eagerly runs queue.clean on file-parse/crm-sync every N minutes so financial PII
# (file bytes / parsed operations) can't linger past its age on an idle portal — BullMQ's age
# eviction is LAZY (fires only on the next terminal job). On by default (privacy posture);
# opt out with STATEMENT_SWEEP=0. Interval default 30 min, clamped to [1, 10080].
# STATEMENT_SWEEP=1
# STATEMENT_SWEEP_INTERVAL_MIN=30
# The same sweep tick also caps portal_tombstone growth (#77): the ordering-guard tombstone only
# needs to outlive a late/retried install for the same uninstall (hours), so rows older than
# TOMBSTONE_TTL_DAYS are removed. Default 30 days, clamped to [1, 365].
# TOMBSTONE_TTL_DAYS=30
# ...and sweeps ABANDONED pending bank connections (#485): a connect whose account was never chosen
# lands under a `~pending:` key and used to live forever, one NEW row per retry (the nonce differs
# every time). Rows are removed once they can no longer become a working connection: proven death
# (consent lapsed / measured refresh TTL exhausted) at once, otherwise by age.
# ⚠ Clamped to [1, 30] days — never below a day: the admin starts the connect and the ACCOUNT OWNER
# finishes it, so "bank in the evening, number in the morning" is normal, not neglect.
# PENDING_MAX_AGE_DAYS=2

# OpenTelemetry (#78, docs/OBSERVABILITY.md). DEFAULT OFF: with OTEL_EXPORTER_OTLP_ENDPOINT
# unset the backend behaves exactly as before (the --import bootstrap no-ops). Set the endpoint
# to your OTLP collector to turn on traces+metrics. Financial PII never becomes span attributes
# (allowlist + redaction + hashed portal id) — see docs/PRIVACY.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# TELEMETRY_ENABLED=1                       # set 0 to force-off even with an endpoint
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer CHANGE_ME
# OTEL_SERVICE_NAME=client-bank-alfa-by-backend
# OTEL_SERVICE_VERSION=                     # defaults to NUXT_PUBLIC_COMMIT_SHA

# Queue role (one image, three roles — see docs/QUEUES.md «Масштабирование»). Defaults
# below = single container (does everything). In docker-compose.prod.yml the roles are
# split: backend runs QUEUE_WORKERS=0 (API + cron), the `worker` service runs the jobs.
# QUEUE_WORKERS=1        # process jobs in this instance (0 on the HTTP/primary container)
# QUEUE_CRON=1           # run the cron scheduler here — must be 1 on EXACTLY ONE instance
# QUEUE_CONCURRENCY=1    # per-worker parallelism (fetch/parse/crm-sync); raise WITH batching
# RUN_MIGRATION=1        # run schema migration on boot (0 on worker replicas)
# Bank-fetch rate limit (A8): a GLOBAL BullMQ limiter on the fetch queue — shared across ALL
# worker replicas via Redis, so live Alfa calls never exceed QUEUE_FETCH_RATE_MAX per
# QUEUE_FETCH_RATE_DURATION_MS across the whole fleet. Default 100/60000ms = Alfa's per-OAuth-client
# cap (our app has one Alfa client_id → one global cap is correct). A 0/garbage value falls back to
# the default (the cap can't be disabled by a typo). Lower it if Alfa tightens the limit.
# QUEUE_FETCH_RATE_MAX=100
# QUEUE_FETCH_RATE_DURATION_MS=60000
# Explicit saturation signal for the cap above (A8 follow-up): after each real poll the cron logs
# an A8-saturation WARNING when the bank-fetch backlog (waiting+delayed) crosses this threshold —
# so hitting the cap is greppable, not a mystery backlog on the chart. Default 200; 0/garbage → default
# (can't be silenced by a typo). NOTE: measures the whole fetch queue, so keep DEMO_LOAD_N=0 in a
# real-poll deployment (demo jobs would inflate the backlog and false-trip the warning).
# QUEUE_FETCH_SATURATION_THRESHOLD=200
# Manual «Опросить сейчас» test trigger (#54): POST /api/poll-now enqueues an on-demand bank poll
# of the caller-portal's connected accounts (admin-gated). OFF by default — frequency is regulated
# APP-SIDE, not by a portal user/admin: set MANUAL_POLL_ENABLED=1 to opt portals in. A per-portal
# cooldown (MANUAL_POLL_COOLDOWN_SEC, default 60) + the global A8 limiter keep it under the bank rate.
# MANUAL_POLL_ENABLED=1
# MANUAL_POLL_COOLDOWN_SEC=60
# Distribution smart-process contour (#109 §9): provision (/api/distribution/provision), read
# (/api/distribution/ledger) and recompute (/api/distribution/recompute) the ledger smart processes.
# Admin-gated frame token, single-flight. OFF by default — it CREATES smart processes in the
# client's CRM, and there is no undo in prod (`crm.type.delete` lives only in dev scripts). Same
# posture as every other mutating switch here (autoDistribute / CRON_REAL_POLL / MANUAL_POLL_ENABLED).
# Enable with EXACTLY '1'; «true»/«yes» do not count.
# DISTRIBUTION_PROVISION_ENABLED=1
# crm-sync REST transport (#191) is the @bitrix24/b24jssdk SDK (built-in per-portal
# rate-limiter) — no flag; the former callRest fallback was retired.
#
# crm-sync writes each operation as a universal TODO activity (crm.activity.todo.add, #495 —
# the configurable one broke the company card's layout), then stamps an ORIGINATOR_ID/ORIGIN_ID
# marker with crm.activity.update. Dedup lives in B24 (crm.activity.list search on that marker),
# no local store, no flag. Smoke it on an installed portal with
# `pnpm activity:test --company <id> --apply`.

# --- Bank online-fetch OAuth (stage 5: online statement polling) ----------------
# Per-bank OAuth client creds + token endpoint the backend uses to REFRESH a portal's
# connected bank access token (server/utils/ensureBankToken.ts). All THREE per bank are
# required — a partial set silently disables that bank's online fetch (envCheck warns at
# boot). Leave blank until online fetch is wired for a portal. NB: these are BACKEND names
# (distinct from the dev recon scripts' ALFA_CLIENT_ID/ALFA_BASE_URL in .env.alfabankby).
# Alfa authenticates in the body; Prior via Authorization: Basic (client_secret_basic).
# ALFA_OAUTH_CLIENT_ID=
# ALFA_OAUTH_CLIENT_SECRET=
# ALFA_OAUTH_TOKEN_URL=https://developerhub.alfabank.by:8273/token
# ⚠ Боевой хост Альфы — `ibapi2.alfabank.by:8273`, и переезд на него упирается НЕ в креды, а в
# доверие к сертификату. Node возит собственный список корней, и он не совпадает с системным:
# боевая цепочка Альфы ведёт к корню `AAA Certificate Services`, которого во встроенном списке нет.
# Замерено 2026-08-14: `curl` и `openssl` с той же машины проходят, а из контейнера каждый вызов
# умирает на SELF_SIGNED_CERT_IN_CHAIN и выглядит как «банк не отвечает». Лечится пробросом
# ХОСТОВОГО набора корней (см. HOST_CA_BUNDLE ниже), а не отключением проверки сертификата —
# отключать её нельзя никогда, это единственное, что отличает банк от того, кто им притворился.
# Connect flow (A7b): the redirect_uri registered in the Alfa app (must match EXACTLY) and the
# requested scope. The authorize host is derived from ALFA_OAUTH_TOKEN_URL (strip `/token`), so no
# separate authorize-base var. Without ALFA_OAUTH_REDIRECT_URI the connect endpoint returns 400.
# The registered spelling is the `/oauth-alfabank-by/` path (same value as the recon-script twin
# ALFA_REDIRECT_URI above) — nginx rewrites it onto the /api/bank/callback handler, so put the
# REGISTERED form here: the bank compares it byte-for-byte against its own record.
# ALFA_OAUTH_REDIRECT_URI=https://bank-import.bx-shef.by/oauth-alfabank-by/
# ALFA_OAUTH_SCOPE=accounts
# PRIOR_OAUTH_CLIENT_ID=
# CLIENT_SECRET нужен ТОЛЬКО при client_secret_basic (тестовая среда). При private_key_jwt (прод)
# секрет не ездит по сети вообще и банк может его не выдавать — оставляйте пустым, см. _AUTH_METHOD.
# PRIOR_OAUTH_CLIENT_SECRET=
# Prior's token endpoint lives UNDER the gateway's auth prefix (and on the :9344 gateway, NOT the
# :9544 issuer — that port only ever appears as the JWT `aud` below).
# PRIOR_OAUTH_TOKEN_URL=https://api.priorbank.by:9344/open-banking-authorize/v1.0/oauth2/token
# Prior connect flow (A5b). Unlike Alfa's plain code flow, Prior's authorize needs a live preamble
# (token Б → /accountConsents → an RS256-SIGNED `request` JWT), so it needs more than id+secret.
# ALL of these (plus CLIENT_ID/CLIENT_SECRET and API_BASE below) must be set or the Prior connect
# endpoint returns a clean 400 — fail-closed, never a half-built authorize URL.
#   _REDIRECT_URI  — registered in the DCR business app (must match EXACTLY); same callback route
#                    as Alfa (both providers land there and are told apart by the signed state).
#   _AUDIENCE      — the JWT `aud` = issuer from /oidcdiscovery (port 9544, NOT the 9344 gateway).
#   _PRIVATE_KEY   — RS256 private key PEM; its public half is registered in the app's `jwks`.
#   _KID           — key id matching the `kid` published in `jwks`.
# Как и у Альфы, ставь ЗАРЕГИСТРИРОВАННУЮ в банке форму пути — nginx-алиас `/oauth-priorbank-by/`
# доводит её до общего обработчика `/api/bank/callback`. Банк сверяет строку байт-в-байт.
# PRIOR_OAUTH_REDIRECT_URI=https://bank-import.bx-shef.by/oauth-priorbank-by/
# PRIOR_OAUTH_AUDIENCE=https://api.priorbank.by:9544/oauth2/token
# PRIOR_OAUTH_PRIVATE_KEY=
# PRIOR_OAUTH_KID=prior-key-1
#
# Client authentication at Prior's token endpoint (#444). Two supported values:
#   client_secret_basic — DEFAULT. **Sandbox only**: the bank's guide (p. 9 §2.2) says this method
#                         "используется только для тестовой среды". Creds go in the Authorization
#                         header.
#   private_key_jwt     — **required for production**. A short-lived RS256 `client_assertion`
#                         (signed with _PRIVATE_KEY / _KID, verified against the app's `jwks`)
#                         travels in the request BODY; no client secret on the wire, no mutual TLS
#                         and therefore no ГосСУОК certificate.
# ⚠ DCR registers ONE method per application, so this MUST match what the app was registered with
# (`--auth-method` in `pnpm prior:test`, which also drives `--dcr`). A mismatch is a 401 at
# whichever call site was missed — and one of them (token Б, creating the consent) fails at the
# very FIRST step of connecting, before any other call is reached.
# Unknown/blank value ⇒ falls back to client_secret_basic (fail-safe: never silently arm a prod
# method the registration may not carry).
# PRIOR_OAUTH_AUTH_METHOD=client_secret_basic
#
# Statement API base + path the transport GETs the statement window from
# (server/utils/bankFetch.ts `bankApiConfig`). Distinct from the *_TOKEN_URL above:
# TOKEN_URL refreshes the OAuth token; API_BASE is the resource host. Unset ⇒ that
# bank's online fetch is OFF (fetchBankStatement throws rather than silently returning
# []). Alfa path defaults to the partner prefix `/partner/1.2.0` (override via
# ALFA_OAUTH_API_PREFIX). For Prior this is the GATEWAY origin (:9344) — one base serves the whole
# BACKEND side (token Б / consent / the async statement create+poll, A5b); the API path prefixes are
# applied in code (PRIOR_API_PREFIXES). The authorize page is NOT part of it — see AUTHORIZE_BASE.
# ALFA_OAUTH_API_BASE=https://developerhub.alfabank.by:8273
# ALFA_OAUTH_API_PREFIX=/partner/1.2.0
# PRIOR_OAUTH_API_BASE=https://api.priorbank.by:9344
# Адрес, куда ходит BACKEND (токен, согласие, счета, выписка). В проде это BY-крипто TLS-шлюз
# (#41/#455) — тогда допустим обычный http:// на ВНУТРЕННИЙ адрес (localhost / имя docker-сервиса /
# приватная сеть): крипто-TLS поднимает сам шлюз. http:// на ПУБЛИЧНЫЙ хост отвергается — это
# отправило бы токен открытым текстом.
#
# PRIOR_OAUTH_AUTHORIZE_BASE — публичный адрес банка для страницы авторизации, которую открывает
# БРАУЗЕР администратора. Не задан ⇒ берётся PRIOR_OAUTH_API_BASE (верно, пока шлюза нет).
# ⚠ При включении шлюза задать ОБЯЗАТЕЛЬНО: если сюда попадёт внутренний адрес, подключение банка
# умрёт молча — сервер этот запрос не делает и ошибки не увидит. Всегда https и не внутренний хост.
# ⚠ И это НЕ `:9345`. Туда идёт браузер владельца счёта, а `:9345` говорит по белорусской
# криптографии — обычный браузер получает там ERR_SSL_PROTOCOL_ERROR (замерено 2026-08-15). Адрес
# страницы авторизации банк называет сам: инструкция §3.3 и боевой /oidcdiscovery дают `:9344`.
# Раскладка всех четырёх портов с источниками — docs/PRIOR_API.md, «Какой адрес куда».
# PRIOR_OAUTH_AUTHORIZE_BASE=https://api.priorbank.by:9344
#
# ⚠ PRIOR_OAUTH_API_BASE и PRIOR_OAUTH_TOKEN_URL — НЕЗАВИСИМЫ. При переводе на шлюз менять обе,
# иначе обновление токена продолжит ходить на старый хост (envCheck предупредит о рассинхроне).
#
# --- Крипто-шлюз (сервис `crypto-gw`, #460) ------------------------------------
# Ключевого материала шлюзу НЕ нужно: аутентификация банка односторонняя, наша идёт через
# private_key_jwt своим RSA-ключом (см. PRIOR_OAUTH_PRIVATE_KEY выше). Ключ ГосСУОК, аппаратный
# носитель и бухгалтер в схеме не участвуют. Устройство образа — https://github.com/bx-shef/bee2-tls-gateway.
#
# ⚠ Имена ЗДЕСЬ и ВНУТРИ контейнера намеренно разные: внутри образа переменные называются `GW_*`
# (он ничего не знает про Приор и переиспользуем), а в этом файле — с префиксом `PRIOR_GW_`, как
# и все остальные приорские настройки. Сопоставление делает docker-compose.prod.yml.
#
# Каталог с корнями ГосСУОК — ОБЯЗАТЕЛЕН при включении шлюза, дефолта нет намеренно: на прод-сервере
# репозитория нет, и относительный путь docker молча создал бы пустым каталогом, отправив шлюз в
# restart-loop. Создать каталог и положить в него `gossuok-bundle.pem` (и `bank-leaf-reference.pem`,
# чтобы работала проверка цепочки на старте) из https://github.com/bx-shef/bee2-tls-gateway/tree/main/ca.
# PRIOR_GW_CA_DIR=/opt/prior-crypto/ca
# Хост и порт банка для шлюза: прод — apibel.priorbank.by:9345, песочница — api.priorbank.by:9344.
# PRIOR_GW_UPSTREAM_HOST=apibel.priorbank.by
# PRIOR_GW_UPSTREAM_PORT=9345
# Уровень error-лога nginx в шлюзе. По умолчанию `crit`, потому что на уровне `error` nginx печатает
# строку запроса целиком, а в ней едет номер счёта. На живой прогон поднять до `info` и вернуть.
# PRIOR_GW_LOG_LEVEL=crit

# --- Operator login (employee/ops area: /queues, later the import pages) --------
# Public /login form outside Bitrix24. WITHOUT a password the login endpoint returns 503, and the
# gated area is OPEN only outside production (dev convenience). In PRODUCTION a missing password
# means the zone is CLOSED (fail-closed): a half-configured deploy must not publish ops data — it
# once served every installed portal's member_id to anyone who knew the URL. So in prod: REQUIRED.
PUBLIC_PAGE_BASIC_AUTH_USER=operator
# Shared operator password. Server-side only, never in the repo/logs. Required to
# ENABLE login. Generate: openssl rand -hex 16.
PUBLIC_PAGE_BASIC_AUTH_PASS=
# HMAC secret signing the session cookie. In dev/test, if empty it is derived from
# the password (so a set password alone works). In PRODUCTION it is REQUIRED and is
# NOT derived from the password (a leaked cookie would otherwise enable an offline
# attack on the password): unset in prod ⇒ the operator zone is LOCKED (fail-closed),
# and the backend logs a startup ERROR. openssl rand -hex 32.
SESSION_SECRET=
# Session lifetime in hours (default 12).
# SESSION_TTL_HOURS=12
# In-Nitro security headers + login rate-limit (server/middleware/securityHeaders.ts). For the
# NO-NGINX deploy only (Vibecode Black Hole — docs/DEPLOY_VIBECODE.md): set to 1 so the single
# Nitro process emits CSP/nosniff/Referrer-Policy/Permissions-Policy/HSTS and throttles POST
# /api/auth/login (~10/min per IP). LEAVE UNSET behind nginx (nginx already sets these) — the
# middleware is a no-op when empty/0, so the main prod path is unchanged.
# SECURITY_HEADERS_ENABLED=1

# --- Feedback channel (docs/FEEDBACK.md, channel «сотрудник») -------------------
# Employee 👍/👎 on the import result → a GitHub issue in a PRIVATE receiving repo.
# FAIL-CLOSED: the channel is OFF (widget hidden, POST /api/feedback → 503) unless
# BOTH are set. Never point the repo at the public code repo — employee comments may
# carry client data (account, sums, counterparties). The repo MUST be private.
# GitHub token with `issues:write` on the receiving repo (fine-grained PAT).
GITHUB_FEEDBACK_TOKEN=
# owner/repo of the PRIVATE receiving repo (e.g. bx-shef/client-bank-alfa-by-feedback).
GITHUB_FEEDBACK_REPO=

# --- Alert channel: Telegram (docs/OPERATIONS.md, #426) -------------------------
# Push-уведомления ОПЕРАТОРУ о проблемах системы: очередь встала, задачи исчерпали
# ретраи, очередь не читается (Redis). Проверка раз в 5 минут на cron-инстансе.
# FAIL-CLOSED: канал ВЫКЛЮЧЕН, пока не заданы ОБЕ переменные — тогда аварии уходят
# только в лог и на /queues, то есть их надо смотреть самому. Половинчатая настройка
# тоже = выключен, и envCheck об этом предупредит на старте.
# ⚠ Это НАША инфраструктура пишет НАМ. Это не чат ошибок портала (`errorChat` в
# настройках приложения) — туда идёт «этот платёж требует человека», сюда «сервис
# сломан». В сообщения не попадают суммы/счета/назначения/контрагенты — только имена
# очередей и счётчики (docs/PRIVACY.md).
# Токен бота от @BotFather, вид «<цифры>:<строка>».
TELEGRAM_ALERT_BOT_TOKEN=
# Куда писать: id чата (у группы отрицательный, «-100…»), id пользователя или @канал.
# Бота нужно добавить в группу/канал, иначе Telegram ответит 403.
TELEGRAM_ALERT_CHAT_ID=

# --- Доверие к сертификатам банков -------------------------------------------------------------
# Путь к набору корневых сертификатов ХОСТА; `docker-compose.prod.yml` монтирует его backend'у и
# воркеру только на чтение и подставляет в `NODE_EXTRA_CA_CERTS`. Переменная добавляет корни к
# встроенным в Node, ничего не подменяя: нет файла — вернётся прежнее поведение, а не ослабленная
# проверка. Менять нужно, только если в системе набор лежит не по стандартному пути (не-Debian).
# HOST_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# --- Крипто-шлюз Приорбанка: список разрешённых маршрутов ----------------------------------------
# Шлюз пропускает ТОЛЬКО перечисленные пары «метод + путь», всё остальное отдаёт 404, не доходя до
# банка (в его логе это `route=none … upstream=-`). Умолчание в docker-compose.prod.yml открывает
# ровно то, что нужно ежедневному опросу: получение токена и ресурсный API.
#
# ⚠ Переменная ЗАМЕНЯЕТ список целиком, а не дополняет его — расширяя, переписывай и прежние две
# записи, иначе опрос встанет. ⚠ Пустое значение НЕ означает «умолчание»: шлюз поймёт его как «ни
# одного маршрута» и закроется наглухо. ⚠ Читается только при старте контейнера.
#
# Расширенный список нужен на время РАЗОВОЙ процедуры — регистрации приложения через DCR. Порядок
# и проверка — docs/OPERATIONS.md. Строка целиком (в одну строку: перенос внутри значения ломает
# старт шлюза):
# PRIOR_GW_ALLOW=POST =/open-banking-authorize/v1.0/oauth2/token; GET,POST /open-banking/v1.0/; POST =/open-banking-dcr/v1.0/register; GET /open-banking-dcr/v1.0/register/; GET =/open-banking-dcr/v1.0/oidcdiscovery
