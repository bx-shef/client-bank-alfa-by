# Каталог-заглушка сайта bank-app.<домен> (/home/bitrix/ext_www/<домен>).
#
# Штатно сюда не приходит НИЧЕГО: nginx BitrixVM отдаёт весь домен контейнеру
# (bx/site_settings/<домен>/*.conf). Этот файл — страховка на случай, когда
# проксирование сломано или снято: тогда запрос доходит до Apache, и он не должен
# ни листать каталог, ни отдавать что-либо кроме заглушки.
#
# ⚠ Из исходного файла УБРАНЫ две вещи, и обе намеренно:
#   1. RewriteRule на https://www.portal.standartno.by — редирект на ЧУЖОЙ сайт.
#      Он приехал из docroot портала копипастой. Оставь мы его — служебный домен
#      приложения молча уводил бы посетителей (и поисковики) на портал клиента.
#   2. Access-Control-Allow-Origin для портала. CORS тут не нужен вовсе: браузер
#      ходит на этот домен напрямую, а не кросс-доменно, и раздавать разрешение
#      «с этого origin можно читать мои ответы» каталогу-заглушке незачем.
# Правило простое: заголовки и редиректы отдаёт то, что реально обслуживает домен
# (nginx + контейнер), а не аварийный резерв.

Options -Indexes

<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

# Отдаём ровно два файла — заглушку и страницу ошибки. Всё остальное (следы
# установки, дампы, забытые скрипты) недоступно по умолчанию, а не по списку:
# перечислять запрещённое — значит однажды забыть новый файл.
Require all denied

<Files "index.php">
    Require all granted
</Files>

<Files "500.html">
    Require all granted
</Files>
