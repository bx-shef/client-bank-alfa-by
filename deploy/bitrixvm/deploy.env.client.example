# Вариант 1 (штатный): сервер следит за КЛИЕНТСКИМ репозиторием.
# Файл: /etc/bank-app-deploy/deploy.env, права 0600 root:root.
#
# Здесь живёт код с правками под этого клиента, его CI собирает образы в его GHCR.
# Обновления апстрима попадают сюда merge'ем — то есть решение «принять новую версию»
# принимает человек, а сервер лишь исполняет уже принятое.

GIT_URL=git@github.com:<владелец>/<репозиторий>.git
GIT_BRANCH=main
GIT_SSH_KEY=/etc/bank-app-deploy/deploy_key

IMAGE_APP=ghcr.io/<владелец>/<репозиторий>
IMAGE_BACKEND=ghcr.io/<владелец>/<репозиторий>-backend

REGISTRY_HOST=ghcr.io
REGISTRY_USER=<github-логин>
REGISTRY_TOKEN_FILE=/etc/bank-app-deploy/registry_token

STACK_DIR=/home/bitrix/bank-import
