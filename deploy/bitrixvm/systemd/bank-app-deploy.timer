[Unit]
Description=Опрос git на предмет новой версии приложения импорта выписки

[Timer]
# Первый опрос — через минуту после загрузки, дальше каждые 5 минут.
# ⚠ Интервал дешёвый: тик без изменений — это один `git ls-remote`, без клонирования
# и без обращения к реестру.
OnBootSec=1min
OnUnitActiveSec=5min
# ⚠ Разброс обязателен. Без него все машины, обновлённые из одного образа, стучатся
# в GitHub секунда в секунду — и упираются в лимит запросов все разом, то есть
# обновления перестают приходить именно тогда, когда клиентов стало много.
RandomizedDelaySec=90
# Пропущенные за время выключения тики не копятся в очередь, а выполняются один раз.
Persistent=true

[Install]
WantedBy=timers.target
