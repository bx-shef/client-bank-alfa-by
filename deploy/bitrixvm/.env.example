# .env для развёртывания на виртуальной машине Битрикс24 (docs/DEPLOY_BITRIXVM.md).
# Кладётся рядом с обоими compose-файлами, в /home/bitrix/bank-import/.
#
# ⚠ Это ДОПОЛНЕНИЕ к корневому .env.example, а не замена: все переменные приложения
# (банки, телеметрия, свипы, лимиты) описаны там и здесь СОЗНАТЕЛЬНО не дублируются —
# вторая копия списка разъезжается с первой молча.

# ── Оба compose-файла разом, чтобы не забыть второй ──────────────────────────
# Забытый оверлей означает молчаливый откат к схеме с nginx-proxy: контейнер не
# опубликуется на 127.0.0.1, и домен начнёт отдавать 502 без единой ошибки в логе.
COMPOSE_FILE=docker-compose.prod.yml:docker-compose.bitrixvm.yml

# ── Образы: GHCR клиентского репозитория ────────────────────────────────────
# Собираются его же CI. Приватный репозиторий ⇒ приватный GHCR ⇒ на сервере нужен
# docker login токеном с правом read:packages (см. docs/DEPLOY_BITRIXVM.md).
APP_IMAGE=ghcr.io/<владелец>/<репозиторий>:latest
BACKEND_IMAGE=ghcr.io/<владелец>/<репозиторий>-backend:latest

# Порт на loopback, в который смотрит nginx ВМ (bx/site_settings/<домен>/00-app-proxy.conf).
# Меняется только при конфликте с чем-то уже занятым на этой машине.
APP_BIND_PORT=8080

# ⚠ NUXT_PUBLIC_LOCAL_MODE (скрыть наши промо и брендинг) задаётся НЕ здесь: флаг build-time,
# статика пререндерится на сборке и рантайм-переменную не подхватит. Его место — переменная
# клиентского репозитория, см. docs/DEPLOY_BITRIXVM.md.

# ── Домен ───────────────────────────────────────────────────────────────────
# DOMAIN здесь НЕ управляет TLS (его выпускает и продлевает меню BitrixVM) и не
# управляет адресом приложения внутри страниц: NUXT_PUBLIC_SITE_URL запекается в
# образ при СБОРКЕ, то есть задаётся переменной клиентского репозитория, а не тут.
# Значение остаётся ради инертных VIRTUAL_HOST/LETSENCRYPT_HOST базового файла.
DOMAIN=bank-app.standartno.by
LETSENCRYPT_EMAIL=

# ── Секреты (обязательные) ──────────────────────────────────────────────────
# openssl rand -hex 32
B24_TOKEN_ENC_KEY=
POSTGRES_PASSWORD=
# openssl rand -hex 32 — подпись сессии оператора и OAuth-state банка
SESSION_SECRET=
# Пароль зоны оператора (/queues). Пусто ⇒ вход выключен.
PUBLIC_PAGE_BASIC_AUTH_PASS=

# ── Bitrix24 ────────────────────────────────────────────────────────────────
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# Коробочный портал: SSRF-гейт по умолчанию пускает только облачные *.bitrix24.*,
# поэтому домен портала нужно назвать явно — иначе серверные вызовы в портал
# отвергаются нами же, ещё до сети.
B24_SELFHOSTED_HOSTS=portal.standartno.by
# Один портал (не Маркет) ⇒ задать обязательно, см. docs/DEPLOY.md.
B24_APPLICATION_TOKEN=

# ── Опрос банков ────────────────────────────────────────────────────────────
# Включать ПОСЛЕ того, как подключён хотя бы один счёт и проверена сверка счетов.
CRON_REAL_POLL=0
