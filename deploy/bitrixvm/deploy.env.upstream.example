# Вариант 2: сервер следит НАПРЯМУЮ за апстримом (репозиторий исполнителя).
# Файл: /etc/bank-app-deploy/deploy.env, права 0600 root:root.
#
# ⚠ Годится, только когда под этого клиента НЕТ правок в коде: любая правка живёт в
# клиентском репозитории, а здесь её просто нет — и первый же тик откатил бы её,
# развернув чистый апстрим. Второе ограничение: NUXT_PUBLIC_SITE_URL и домены портала
# в CSP запечены в образы апстрима под ЕГО домен, поэтому установка в портал работать
# не будет — этот вариант пригоден для стенда и демонстрации лендинга, не для боя.
#
# ⚠ Тут же и разница в доверии: следя за апстримом, сервер клиента разворачивает у себя
# каждый наш коммит в main без чьего-либо решения на его стороне.

GIT_URL=git@github.com:bx-shef/client-bank-alfa-by.git
GIT_BRANCH=main
GIT_SSH_KEY=/etc/bank-app-deploy/deploy_key

IMAGE_APP=ghcr.io/bx-shef/client-bank-alfa-by
IMAGE_BACKEND=ghcr.io/bx-shef/client-bank-alfa-by-backend

REGISTRY_HOST=ghcr.io
REGISTRY_USER=<github-логин>
REGISTRY_TOKEN_FILE=/etc/bank-app-deploy/registry_token

STACK_DIR=/home/bitrix/bank-import
