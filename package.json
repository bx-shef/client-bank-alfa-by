{
  "name": "client-bank-alfa-by",
  "type": "module",
  "private": true,
  "description": "Приложение для получения выписки из клиент-банка Альфа-Банк Беларусь (Nuxt SSG)",
  "license": "MIT",
  "author": "ИП Шевчик И. С.",
  "homepage": "https://github.com/bx-shef/client-bank-alfa-by#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bx-shef/client-bank-alfa-by.git"
  },
  "bugs": {
    "url": "https://github.com/bx-shef/client-bank-alfa-by/issues"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate && pnpm seo:files",
    "seo:files": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/seo-files.mjs",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && vue-tsc -p .nuxt/tsconfig.server.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.visual.json --noEmit",
    "typecheck:server": "vue-tsc -p .nuxt/tsconfig.server.json --noEmit",
    "typecheck:node": "vue-tsc -p tsconfig.node.json --noEmit",
    "typecheck:visual": "vue-tsc -p tsconfig.visual.json --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "screenshot": "node scripts/screenshot.mjs",
    "icons": "node scripts/make-icons.mjs",
    "og": "node scripts/make-og.mjs",
    "oauth:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/alfa-oauth-test.mjs",
    "prior:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/prior-oauth-test.mjs",
    "parse:statement": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/parse-statement.ts",
    "fuzz:allocation": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/fuzz-allocation.ts",
    "seed:b24": "node scripts/seed-test-b24.mjs",
    "verify:109": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/verify-109-live.ts",
    "verify:chat": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/verify-chat-live.ts",
    "probe:sp-filter": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/probe-sp-company-filter.ts",
    "verify:distribution": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/verify-distribution-live.ts",
    "verify:bindings": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/verify-bindings-live.ts",
    "verify:registry": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/verify-registry-live.ts",
    "mutate:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/mutate-payment-live.ts",
    "sdk:test": "node scripts/b24-sdk-test.mjs",
    "sdk:crm:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/sdk-crm-test.ts",
    "sdk:oauth": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/sdk-oauth-test.ts",
    "activity:inspect": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/activity-inspect.ts",
    "activity:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/todo-activity-test.ts",
    "trigger:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/trigger-register-test.ts",
    "feedback:retention": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/lib/alias-loader.mjs scripts/feedback-retention.ts",
    "postinstall": "nuxt prepare",
    "loadtest:queue": "node scripts/queue-loadtest.mjs",
    "seed:companies": "node scripts/seed-companies-b24.mjs",
    "make:statement": "node scripts/make-test-statement.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@bitrix24/b24icons-vue": "^2.0.7",
    "@bitrix24/b24jssdk": "^2.0.0",
    "@bitrix24/b24jssdk-nuxt": "^2.0.0",
    "@bitrix24/b24ui-nuxt": "^2.10.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "bullmq": "^6.2.0",
    "echarts": "^6.1.0",
    "ioredis": "^5.11.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@unhead/vue": "3.3.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "nuxt": "^4.5.2",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <2.1.2": "^2.1.2",
      "brace-expansion@>=5.0.0 <5.0.8": "^5.0.8",
      "postcss@<8.5.18": "^8.5.18",
      "tar@>=7.0.0 <7.5.21": "^7.5.21"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}
